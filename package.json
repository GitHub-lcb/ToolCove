{
  "name": "toolcove",
  "private": true,
  "version": "0.11.0",
  "//mobileVersion": "手机端（安卓 App）的独立版本号：与桌面 version 各走各的发版线。改这里即可，app/build.gradle 的 versionName 会从它读取（单一真相源，避免两处手改不一致）。发版：推 apk-v<版本> 标签触发 mobile-release.yml。",
  "mobileVersion": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//dev:tauri": "tauri dev 专用：钉在 1421（与 tauri.conf.json 的 devUrl 必须一致），且 --strictPort——被占用时直接报错，而不是换个端口让桌面窗口白屏。1421 而不是 1420 是为了让「浏览器 dev 跑在 1420」和「桌面 dev」能同时开。npm run dev 仍允许往后滑档。",
    "dev:tauri": "vite --port 1421 --strictPort",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:mobile": "vite build --config mobile/vite.mobile.config.js",
    "dev:mobile": "vite --config mobile/vite.mobile.config.js",
    "build:apk": "node mobile/android/build-apk.mjs",
    "tauri": "tauri",
    "release": "node scripts/release.js",
    "test:android": "node mobile/android/test-bridge.mjs",
    "verify:apk": "node mobile/android/verify-apk.mjs",
    "build:label-wasm": "node crates/label-core/build-wasm.mjs",
    "//bank:fetch": "从 GitHub 批量拉题，生成可导入的题库 JSON。产物默认落 tmp/（已 gitignore）——这些仓库的许可证各不相同，入库或随应用分发前请先确认（脚本头部有说明）。",
    "bank:fetch": "node scripts/build-interview-bank.mjs"
  },
  "dependencies": {
    "@jspawn/qpdf-wasm": "^0.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bowser": "^2.14.1",
    "cron-parser": "^5.10.0",
    "diff": "^8.0.4",
    "exceljs": "^4.4.0",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.3.0",
    "luxon": "^3.7.2",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
