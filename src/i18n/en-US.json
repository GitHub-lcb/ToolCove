  "prompt": {
    "extractFieldLine": "- {key} ({label})",
    "extractFieldDesc": ": {desc}",
    "extractFieldBool": " (boolean true/false; checked/yes in the image means true, fill false when uncertain)",
    "extractFieldEnum": " (must be one of: {values}; leave empty when uncertain)",
    "extractGroupLine": "- {key} ({title}): array, each element represents one row of the table, fields:",
    "extractGroupsHead": "You are an information extraction assistant. The user's screenshots may contain [one or more] tables listed below. First determine which tables actually appear in the images, then extract every data row of each table into a JSON object. Output strictly one single JSON object whose keys are table names and values are row arrays; return an empty array [] for tables not present in the images. Do not output any explanation, prefixes, suffixes or code fences. Table definitions:",
    "extractGroupsTail": "Requirements: extract only data rows that truly exist in the images, never fabricate; header rows and placeholder rows (e.g. 'no data yet') are not data rows; fill an empty string for unrecognized fields (false for boolean fields). Table data may not appear as regular tables: if the images contain merged cells or free text paragraphs of remarks/notes whose content clearly maps to a table's fields (e.g. mentioning a .sql script file name and an owner implies the database scripts table), split them into rows of that table as well, leave unmapped fields empty and put remaining notes into a remarks field; still never fabricate. Pay special attention to [row-spanning merged cells]: if a cell in a column visually spans multiple rows, its content applies to all those rows, so fill the same value for that field in each of those rows; strictly judge which row each column's content belongs to by the vertical boundaries of each row, and never shift content to adjacent rows.",
    "extractSingleHead": "You are an information extraction assistant. Extract information from the user's screenshots and output strictly one single JSON object, ",
    "extractManyHead": "You are an information extraction assistant. The user's screenshots may contain [multiple] records (e.g. a list or table). Extract each record in the images into a JSON object and output strictly one single JSON array, ",
    "extractFieldsIntro": "do not output any explanation, prefixes, suffixes or ```json code fences. Field definitions:",
    "extractSingleTail": "Requirements: the JSON keys must match the definitions above; fill an empty string \"\" for fields that cannot be recognized from the images; never fabricate content that does not exist in the images.",
    "extractManyTail": "Requirements: the keys of every array element must match the definitions above; extract only entries that truly exist in the images, never fabricate; fill an empty string for unrecognized fields. Pay special attention to [row-spanning merged cells]: if a cell in a column visually spans multiple rows, its content applies to all those rows, so fill the same value for that field in each of those rows; strictly judge which row each column's content belongs to by the vertical boundaries of each row, and never shift content to adjacent rows.",
    "extractHintSingle": "Extract the fields above from this screenshot and return JSON only.",
    "extractHintMany": "Extract every record in the screenshots as an array element and return a JSON array only.",
    "extractHintGroups": "Identify the tables in the screenshots and extract every row grouped by table; return a JSON object only.",
    "extractErrNoFields": "No fields defined for extraction",
    "extractErrNoGroups": "No groups defined for extraction",
    "extractErrNoImages": "Please provide screenshots first",
    "snippetExtractHint": "This is a screenshot containing commands/SQL/tables/config/text, possibly with multiple entries. Extract every entry that can be saved as a snippet into one record (title, category and content).",
    "problemExtractHint": "This is a screenshot of production issues/tickets/meetings/messages, possibly with multiple entries. Extract each entry into one record (issue title, type and note).",
    "problemAnalysisIntro": "You are a senior backend/full-stack engineer. Analyze the following production issue and answer entirely in English.",
    "problemAnalysisTitle": "[Issue title] {text}",
    "problemAnalysisType": "[Type] {text}",
    "problemAnalysisNote": "[Issue description] {text}",
    "problemAnalysisResolution": "[Existing investigation / conclusion] {text}",
    "problemAnalysisTags": "[Tags] {text}",
    "problemAnalysisTagSep": ", ",
    "problemAnalysisAsk": "Based on the description, please provide: 1. possible root-cause directions (ranked by likelihood), 2. investigation steps (logs, SQL, API verification), 3. fix suggestions."
  },
