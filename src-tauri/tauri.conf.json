{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolCove",
  "mainBinaryName": "ToolCove",
  "version": "0.2.1",
  "identifier": "com.github-lcb.toolcove",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToolCove",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQTczREY1NzdGQzlBMkEKUldRcW12eDM5VDJuV3J2SVdxSkloRWN0dlU0Qy9lQVVVdHMrOHBQaTBsVEU2cjZ2Mi9SOEY4V1UK",
      "endpoints": [
        "https://github.com/GitHub-lcb/ToolCove/releases/latest/download/latest.json"
      ]
    }
  }
}
